<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Upload Assignment</title>
   <link rel="stylesheet" href="/uploadAssinment.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
   
<link rel="stylesheet" href="/userdashboard.css">
</head>

<body>
<div class="dashboard-container">
   <aside class="sidebar">
      <div class="sidebar-header">
         <i class="fa-solid fa-graduation-cap"></i>
         <h2>User Profile</h2>
      </div>
      <nav class="sidebar-nav">
         <a href="/user/dashboard" class="nav-item"><i class="fa-solid fa-house-chimney"></i> Dashboard</a>
         <a href="/user/assignments" class="nav-item"><i class="fa-solid fa-book-open"></i> Assignments</a>
            <% if (user && user.Role === 'Professor' || user && user.role === 'Professor') { %>
            <a href="/user/review-portal" class="nav-item"><i class="fa-solid fa-list-check"></i> Review Portal</a>
            <% } %>
            <a href="/user/community" class="nav-item"><i class="fa-solid fa-earth-americas"></i> Community Hub</a>
         <a href="/user/profile" class="nav-item"><i class="fa-solid fa-user"></i> Profile</a>
         <a href="/user/uploadAssignment" class="nav-item active"><i class="fa-solid fa-upload"></i> Upload</a>
      </nav>
   </aside>
   <main class="main-content">
      <header class="topbar">
         <div class="welcome-text">
            <h1>Upload Assignment</h1>
            <p>Submit your coursework.</p>
         </div>
         <div class="topbar-actions">
            <a href="/user/about" class="action-link">About</a>
            <a href="/user/contact" class="action-link">Contact</a>
            <a href="/user/logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
         </div>
      </header>
      <section class="content-body" style="background: var(--card-glass); padding: 2rem; border-radius: 12px; margin-top: 1rem; border: 1px solid var(--card-border);">

   <form class="upload-form" action="/user/uploadAssignment" method="post" enctype="multipart/form-data">
      <h1>Upload Assignment</h1>

      <label>Title</label>
      <input type="text" name="title" required>

      <label>Description</label>
      <textarea name="description" rows="5" required></textarea>

      <label>File</label>
      <input type="file" name="assignmentFile" required title="File must be below 10MB">

      <label>Category</label>
      <select name="category" required>
         <option value="">-- Select Category --</option>
         <option value="Assignment">Assignment</option>
         <option value="Thesis">Thesis</option>
         <option value="Report">Report</option>
      </select>
      <button type="submit">Upload</button>
   </form>
      </section>
   </main>
</div>
</body>

<% if (message !== "" || error!=="") { %>
   <div id="toast" style="
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    background: #28a745;
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 15px;
    box-shadow: 0px 2px 8px rgba(0,0,0,0.2);
">
      <%= message || error %>
   </div>

   <script>
      setTimeout(() => {
         document.getElementById('toast').style.display = "none";
      }, 3000);
   </script>
   <% } %>

</html>