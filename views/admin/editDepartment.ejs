<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Document</title>
   <link rel="stylesheet" href="/editDepartment.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/dashboard.css">
</head>

<body>
<div class="dashboard-container">
   <aside class="sidebar">
      <div class="sidebar-header">
         <i class="fa-solid fa-cube"></i>
         <h2>Admin Panel</h2>
      </div>
      <nav class="sidebar-nav">
         <a href="/admin/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
         <a href="/admin/Departments/1" class="nav-item"><i class="fa-solid fa-building"></i> Departments</a>
         <a href="/admin/createDepartment" class="nav-item"><i class="fa-solid fa-plus-square"></i> Add Dept</a>
         <a href="/admin/allUsers/1" class="nav-item"><i class="fa-solid fa-users"></i> Users</a>
         <a href="/admin/createUser" class="nav-item"><i class="fa-solid fa-user-plus"></i> Add User</a>
            <a href="/user/community" class="nav-item"><i class="fa-solid fa-earth-americas"></i> Community Hub</a>
      </nav>
   </aside>
   <main class="main-content">
      <header class="topbar">
         <div class="welcome-text">
            <h1>Edit Department</h1>
            <p>Modify department details.</p>
         </div>
         <div class="topbar-actions">
            <a href="/admin/about" class="action-link">About</a>
            <a href="/admin/contact" class="action-link">Contact</a>
            <a href="/admin/logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
         </div>
      </header>
      <section class="content-body" style="background: var(--card-glass); padding: 2rem; border-radius: 12px; margin-top: 1rem; border: 1px solid var(--card-border);">
   <u>
      <h1>Update Department</h1>
   </u>

   <form action="/admin/departments/update/<%= department._id %>" method="POST">
      <label for="name">Department Name:</label>
      <input type="text" id="name" name="Name" value="<%= department.Name %>">
      <br>

      <label for="type">Type:</label>
      <input type="text" id="type" name="Type" value="<%= department.Type %>"><br>

      <label for="address">Address:</label>
      <input type="text" id="address" name="Address" value="<%= department.Address %>"><br>

      <button type="submit">Update Department</button>
   </form>
      </section>
   </main>
</div>
</body>

</html>