<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>All Department</title>
   <link rel="stylesheet" href="/AllDepartment.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/dashboard.css">
</head>

<body>
<div class="dashboard-container">
   <aside class="sidebar">
      <div class="sidebar-header">
         <i class="fa-solid fa-cube"></i>
         <h2>Admin Panel</h2>
      </div>
      <nav class="sidebar-nav">
         <a href="/admin/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
         <a href="/admin/Departments/1" class="nav-item active"><i class="fa-solid fa-building"></i> Departments</a>
         <a href="/admin/createDepartment" class="nav-item"><i class="fa-solid fa-plus-square"></i> Add Dept</a>
         <a href="/admin/allUsers/1" class="nav-item"><i class="fa-solid fa-users"></i> Users</a>
         <a href="/admin/createUser" class="nav-item"><i class="fa-solid fa-user-plus"></i> Add User</a>
            <a href="/user/community" class="nav-item"><i class="fa-solid fa-earth-americas"></i> Community Hub</a>
      </nav>
   </aside>
   <main class="main-content">
      <header class="topbar">
         <div class="welcome-text">
            <h1>All Departments</h1>
            <p>Manage list of departments.</p>
         </div>
         <div class="topbar-actions">
            <a href="/admin/about" class="action-link">About</a>
            <a href="/admin/contact" class="action-link">Contact</a>
            <a href="/admin/logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
         </div>
      </header>
      <section class="content-body" style="background: var(--card-glass); padding: 2rem; border-radius: 12px; margin-top: 1rem; border: 1px solid var(--card-border);">

   <form action="/admin/Departments/1" method="GET" id="searchForm">
      <label for="search">Search:</label>
      <input type="text" id="search" name="search">

      <label for="filter">Filter By:</label>
      <select name="filter" id="filterSelect">
         <option value=""></option>
         <option value="Name">Name</option>
         <option value="Type">Type</option>
         <option value="Address">Address</option>
      </select>

      <button type="submit">Search</button>
      <br><br>
   </form>

   <table border="1" cellpadding="10" cellspacing="5" style="color:purple; border: 2px solid rgb(84, 133, 133)">
      <tr>
         <th>Name</th>
         <th>Type</th>
         <th>Address</th>
         <th>Actions</th>
      </tr>
      <% departments.forEach(function(dept) { %>
         <tr>
            <td>
               <%= dept.Name %>
            </td>
            <td>
               <%= dept.Type %>
            </td>
            <td>
               <%= dept.Address %>
            </td>
            <td>
               <a href="/admin/departments/edit/<%= dept._id %>"><button>Edit</button></a>
               <button onclick="handleDelete('<%= dept._id %>')">Delete</button>
            </td>
         </tr>
         <% }); %>
   </table>
   <br>
   <div class="pagination">
      <a href="/admin/Departments/<%= curr-1 %>?search=<%= search %>&filter=<%= filter %>"><button>Prev</button></a>
      <a href="/admin/Departments/<%= curr+1 %>?search=<%= search %>&filter=<%= filter %>"><button>Next</button></a>
   </div>

      </section>
   </main>
</div>
</body>

<% if (message || error) { %>
   <div id="toast" style="
    position: fixed;
    top: 15px;
    right: 45%;
    background: #28a745;
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 15px;
    box-shadow: 0px 2px 8px rgba(0,0,0,0.2);
">
      <%= message || error %>
   </div>

   <script>
      setTimeout(() => {
         document.getElementById('toast').style.display = "none";
      }, 3000);
   </script>
   <% } %>

      <script>
         async function handleDelete(deptId) {
            const response = await fetch(`/admin/Departments/checkUsers/${deptId}`);
            const data = await response.json();
            if (data.exists) {
               const ok = confirm("Users are assigned to this department. Do you want to delete it?");
               if (!ok) return;
            }
            window.location.href = `/admin/departments/delete/${deptId}`;
         }
      </script>

</html>