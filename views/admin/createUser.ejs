<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>User Creation</title>
   <link rel="stylesheet" href="/createUser.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/dashboard.css">
</head>

<body>
<div class="dashboard-container">
   <aside class="sidebar">
      <div class="sidebar-header">
         <i class="fa-solid fa-cube"></i>
         <h2>Admin Panel</h2>
      </div>
      <nav class="sidebar-nav">
         <a href="/admin/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
         <a href="/admin/Departments/1" class="nav-item"><i class="fa-solid fa-building"></i> Departments</a>
         <a href="/admin/createDepartment" class="nav-item"><i class="fa-solid fa-plus-square"></i> Add Dept</a>
         <a href="/admin/allUsers/1" class="nav-item"><i class="fa-solid fa-users"></i> Users</a>
         <a href="/admin/createUser" class="nav-item active"><i class="fa-solid fa-user-plus"></i> Add User</a>
            <a href="/user/community" class="nav-item"><i class="fa-solid fa-earth-americas"></i> Community Hub</a>
      </nav>
   </aside>
   <main class="main-content">
      <header class="topbar">
         <div class="welcome-text">
            <h1>Create User</h1>
            <p>Add a new system user.</p>
         </div>
         <div class="topbar-actions">
            <a href="/admin/about" class="action-link">About</a>
            <a href="/admin/contact" class="action-link">Contact</a>
            <a href="/admin/logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
         </div>
      </header>
      <section class="content-body" style="background: var(--card-glass); padding: 2rem; border-radius: 12px; margin-top: 1rem; border: 1px solid var(--card-border);">

   <form action="/admin/createUser" method="POST">

      <label for="userName">User Name:</label>
      <input type="text" id="userName" name="Name" placeholder="Enter user's full name" required>

      <label for="email">Email :</label>
      <input type="email" id="email" name="Email" placeholder="e.g. name@example.com" required>

      <label for="password">Password:</label>
      <input type="password" id="password" name="Password" placeholder="Enter a secure password" required>

      <label for="phone">Phone no.:</label>
      <input type="number" id="phone" name="Phone" placeholder="Enter phone number" required>

      <label for="department">Department:</label>
      <select id="department" name="Department">
         <option>--No Option-- </option>
         <% departments.forEach(element=> { %>
            <option value="<%= element._id %>">
               <%= element.Name %>
            </option>
            <% }) %>
      </select>

      <label for="role">Role:</label>
      <select id="role" name="Role">
         <option>--No Option-- </option>
         <option>Professor</option>
         <option>Student</option>
         <option>HOD</option>
      </select>

      <% if (error) { %>
         <p style="color:red;">
            <%= error %>
         </p>
         <% } %>

            <% if (message) { %>
               <p style="color:green;">
                  <%= message %>
               </p>
               <% } %>

                  <button type="submit">Create User</button>

   </form>


      </section>
   </main>
</div>
</body>

</html>