<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>All Users</title>
   <link rel="stylesheet" href="/AllUsers.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/dashboard.css">
</head>

<body>
<div class="dashboard-container">
   <aside class="sidebar">
      <div class="sidebar-header">
         <i class="fa-solid fa-cube"></i>
         <h2>Admin Panel</h2>
      </div>
      <nav class="sidebar-nav">
         <a href="/admin/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
         <a href="/admin/Departments/1" class="nav-item"><i class="fa-solid fa-building"></i> Departments</a>
         <a href="/admin/createDepartment" class="nav-item"><i class="fa-solid fa-plus-square"></i> Add Dept</a>
         <a href="/admin/allUsers/1" class="nav-item active"><i class="fa-solid fa-users"></i> Users</a>
         <a href="/admin/createUser" class="nav-item"><i class="fa-solid fa-user-plus"></i> Add User</a>
            <a href="/user/community" class="nav-item"><i class="fa-solid fa-earth-americas"></i> Community Hub</a>
      </nav>
   </aside>
   <main class="main-content">
      <header class="topbar">
         <div class="welcome-text">
            <h1>All Users</h1>
            <p>Manage system users.</p>
         </div>
         <div class="topbar-actions">
            <a href="/admin/about" class="action-link">About</a>
            <a href="/admin/contact" class="action-link">Contact</a>
            <a href="/admin/logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
         </div>
      </header>
      <section class="content-body" style="background: var(--card-glass); padding: 2rem; border-radius: 12px; margin-top: 1rem; border: 1px solid var(--card-border);">

   <form action="/admin/allUsers/1" method="GET">
      <label for="search">Search:</label>
      <input type="text" id="search" name="search">

      <label for="filter">Filter By:</label>
      <select name="filter" id="filter">
         <option value="">--Select--</option>
         <option value="Name">Name</option>
         <option value="Role">Role</option>
         <option value="Department">Department</option>
      </select>
      <button type="submit">Search</button>
      </form>

      <table border="1" cellpadding="10" cellspacing="5" style="color:purple; border: 2px solid rgb(84, 133, 133)">
         <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Role</th>
            <th>Actions</th>
         </tr>
         <% users.forEach(function(user) { %>
            <tr>
               <td>
                  <%= user.Name %>
               </td>
               <td>
                  <%= user.Email %>
               </td>
               <td>
                  <%= user.Phone %>
               </td>
               <td>
                  <%= user.Department.Type %>
               </td>
               <td>
                  <%= user.Role %>
               </td>
               <td>
                  <a href="/admin/editUser/<%= user._id %>"><button>Edit</button></a>
                  <a href="/admin/deleteUser/<%= user._id %>" onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')"><button>Delete</button></a>
               </td>
            </tr>
            <% }); %>
      </table>
      <br>

      <div class="pagination">
         <a href="/admin/allUsers/<%= curr-1 %>"><button>Prev.</button></a>
         <a href="/admin/allUsers/<%= curr+1%>"><button>Next</button></a>
      </div>
      </section>
   </main>
</div>
</body>

<% if (message || error) { %>
   <div id="toast" style="
    position: fixed;
    top: 15px;
    right:45%;
    z-index: 1000;
    background: #28a745;
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    font-size: 15px;
    box-shadow: 0px 2px 8px rgba(0,0,0,0.2);
">
      <%= message || error %>
   </div>

   <script>
      setTimeout(() => {
         document.getElementById('toast').style.display = "none";
      }, 3000);
   </script>

   <% } %>

</html>